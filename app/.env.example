# Только для запуска через docker compose. `make init` создаёт .env со случайными паролями.
# Пароль БД — только буквы и цифры: он подставляется в DSN как есть.
DB_PASSWORD=
GRAFANA_PASSWORD=
# пауза между проходами сборщика, секунды (6 часов)
INTERVAL_SECONDS=21600
# 127.0.0.1 — Grafana только локально; 0.0.0.0 — открыть наружу
GRAFANA_BIND=127.0.0.1
GRAFANA_ROOT_URL=http://localhost:3000/
