# Generated by roles/jobmon for this installation. Do not edit on the host.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: jobmon

resources:
  - ../base

images:
  - name: jobmon-collector
    newName: {{ jobmon_collector_image.rsplit(':', 1)[0] }}
    newTag: "{{ jobmon_collector_image.rsplit(':', 1)[1] }}"

secretGenerator:
  - name: jobmon
    literals:
      - DB_PASSWORD={{ jobmon_db_password }}
      - GRAFANA_PASSWORD={{ jobmon_grafana_password }}
{% if ghcr_pull_token | default('') | length > 0 %}
  - name: ghcr-pull
    type: kubernetes.io/dockerconfigjson
    literals:
      - '.dockerconfigjson={{ {'auths': {'ghcr.io': {'auth': (ghcr_pull_user ~ ':' ~ ghcr_pull_token) | b64encode}}} | to_json(separators=(',', ':')) }}'
{% endif %}

configMapGenerator:
  - name: jobmon-settings
    literals:
      - GRAFANA_HOST={{ jobmon_grafana_host }}
      - TAILNET_DOMAIN={{ tailnet_domain }}

patches:
  - target:
      kind: Ingress
      name: grafana
    patch: |-
      - op: replace
        path: /spec/tls/0/hosts/0
        value: {{ jobmon_grafana_host }}
{% if ghcr_pull_token | default('') | length > 0 %}
  - target:
      kind: CronJob
      name: collector
    patch: |-
      - op: add
        path: /spec/jobTemplate/spec/template/spec/imagePullSecrets
        value: [{name: ghcr-pull}]
{% endif %}
